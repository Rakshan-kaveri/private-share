# Google OAuth Web client ID (public identifier, not a client secret)
GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id
APP_ORIGIN=https://share.rakzu.xyz
ICE_SERVERS_JSON=[]

# TURN is optional for local-only testing; required for relay fallback.
# Use a publicly reachable VPS or a host with a real public IP and firewall access.
TURN_HOST=turn.share.rakzu.xyz
TURN_REALM=share.rakzu.xyz
TURN_PUBLIC_IP=REPLACE_WITH_PUBLIC_SERVER_IPV4
# Generate with: openssl rand -hex 32. Keep identical in backend and coturn; never commit .env.
TURN_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
