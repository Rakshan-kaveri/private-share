# Google OAuth "Web application" client ID (public, not a secret).
# Authorized JavaScript origin in Google Cloud must be exactly APP_ORIGIN.
GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id
APP_ORIGIN=https://share.rakzu.xyz

# Host port (loopback only) that Cloudflare Tunnel points at.
HOST_PORT=8188

# Optional extra STUN/TURN servers as JSON (Google STUN is always included).
ICE_SERVERS_JSON=[]

# TURN relay. Needed when one side is on mobile data / CGNAT / strict office Wi-Fi.
# Leave the placeholders and calls still work whenever a direct path exists.
TURN_HOST=turn.share.rakzu.xyz
TURN_REALM=share.rakzu.xyz
TURN_PUBLIC_IP=REPLACE_WITH_PUBLIC_SERVER_IPV4
TURN_PORT=3478
# Set to 5349 (or 443) only if your coturn also listens with TLS.
TURN_TLS_PORT=0
# Generate with: openssl rand -hex 32   (same value for app and coturn; never commit .env)
TURN_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Name-only test sign-in, for trying the app on a LAN or localhost. Keep false in production.
DEV_LOGIN=false
